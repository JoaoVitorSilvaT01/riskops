RISKOPS_DEBUG=true
SECRET_KEY=change-this-before-deploying
ALLOWED_HOSTS=localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000
# rules (offline, no LLM), gemini or openai. No silent fallback.
AI_PROVIDER=rules
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.1-flash-lite
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
AI_TIMEOUT_SECONDS=25
# Optional fixed HTTPS receiver. Empty = events stay visibly pending.
WEBHOOK_URL=
WEBHOOK_SECRET=
# Set true only for a localhost receiver during development.
WEBHOOK_ALLOW_LOCAL=false
DEMO_PASSWORD=demo-local-2026
